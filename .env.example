# ==============================================================================
# CLOUD-BASED INTELLIGENT FREELANCING MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelance_marketplace?schema=public

# Authentication Secrets
JWT_SECRET=demo_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=demo_secure_cookie_secret_key_12345

# Background Queue & Redis
# Driver options: "bullmq" (Redis required) or "memory" (built-in async queue for zero-dependency local runs)
QUEUE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage / File Uploads
# Driver options: "local" (zero-dependency file storage) or "s3" (AWS S3 or MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=freelance-marketplace-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Matching Engine Configuration (Normalized Weights, Total = 100%)
MATCH_WEIGHT_SKILL=40
MATCH_WEIGHT_EXPERIENCE=20
MATCH_WEIGHT_PERFORMANCE=15
MATCH_WEIGHT_RATING=10
MATCH_WEIGHT_AVAILABILITY=10
MATCH_WEIGHT_BUDGET=5

# Admin Credentials for Seeding & Demo
ADMIN_EMAIL=admin@marketplace.demo
ADMIN_PASSWORD=AdminSecurePassword123!
