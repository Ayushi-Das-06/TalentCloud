# ==============================================================================
# CLOUD-BASED INTELLIGENT FREELANCING MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Local database (SQLite schema: backend/prisma/schema.prisma)
DATABASE_URL=file:./talentcloud.db

# Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=
TRUST_PROXY_HOPS=0

# Background Queue & Redis
# Supported drivers: "bullmq" (Redis required), "memory", or "sqs" (AWS credentials/role required)
QUEUE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AWS_REGION=us-east-1
SQS_REGION=us-east-1
SQS_QUEUE_URL=
# Optional endpoint for local SQS-compatible development services
SQS_ENDPOINT=

# Object Storage / File Uploads
# Use IAM task roles in AWS. Static credentials are optional for local tools only.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_REGION=us-east-1
S3_BUCKET_NAME=talentcloud-files
# Optional endpoint for S3-compatible development services such as MinIO
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Matching Engine Configuration (Normalized Weights, Total = 100%)
MATCH_WEIGHT_SKILL=40
MATCH_WEIGHT_EXPERIENCE=20
MATCH_WEIGHT_PERFORMANCE=15
MATCH_WEIGHT_RATING=10
MATCH_WEIGHT_AVAILABILITY=10
MATCH_WEIGHT_BUDGET=5
