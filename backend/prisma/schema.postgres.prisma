// PostgreSQL Production Prisma Schema for AWS RDS / Docker
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  CLIENT
  ADMIN
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum AvailabilityStatus {
  FULL_TIME
  PART_TIME
  NOT_AVAILABLE
}

enum ProjectComplexity {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum ResumeStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum FileCategory {
  REQUIREMENT
  DELIVERABLE
  RESUME
  PORTFOLIO
  GENERAL
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  HIRED
  TASK_ASSIGNED
  TASK_UPDATED
  PROJECT_COMPLETED
  REVIEW_RECEIVED
  RESUME_PARSED
  SYSTEM
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(FREELANCER)
  avatarUrl    String?
  isSuspended  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  notifications     Notification[]
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")
  uploadedFiles     ProjectFile[]
  createdTasks      Task[]            @relation("CreatedTasks")
  attachments       ProjectAttachment[]

  @@index([email])
  @@index([role])
}

model FreelancerProfile {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline              String?
  bio                   String?
  experienceYears       Int                @default(0)
  experienceLevel       ExperienceLevel    @default(INTERMEDIATE)
  hourlyRate            Decimal?           @db.Decimal(10, 2)
  availability          AvailabilityStatus @default(FULL_TIME)
  portfolioLinks        String?            @default("[]") @db.Text
  education             String?            @default("[]") @db.Text
  preferredCategories   String?            @default("[]") @db.Text
  averageRating         Decimal            @default(0.0) @db.Decimal(3, 2)
  completedProjectsCount Int               @default(0)
  profileCompletion     Int                @default(20)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  skills       FreelancerSkill[]
  resumes      Resume[]
  applications Application[]
  contracts    Contract[]
  tasks        Task[]             @relation("AssignedTasks")

  @@index([experienceLevel])
  @@index([averageRating])
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  industry    String?
  description String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  contracts Contract[]
}

model Skill {
  id             String   @id @default(uuid())
  name           String   @unique
  normalizedName String   @unique
  category       String   @default("General")
  createdAt      DateTime @default(now())

  freelancerSkills FreelancerSkill[]
  projectSkills    ProjectSkill[]

  @@index([normalizedName])
}

model FreelancerSkill {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  yearsExperience     Int               @default(1)
  isVerified          Boolean           @default(false)
  createdAt           DateTime          @default(now())

  @@unique([freelancerProfileId, skillId])
  @@index([freelancerProfileId])
  @@index([skillId])
}

model Resume {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  fileName            String
  fileKey             String
  fileSize            Int
  mimeType            String
  status              ResumeStatus      @default(UPLOADED)
  rawText             String?           @db.Text
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  analysis ResumeAnalysis?

  @@index([freelancerProfileId])
  @@index([status])
}

model ResumeAnalysis {
  id                    String   @id @default(uuid())
  resumeId              String   @unique
  resume                Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  extractedSkills       String   @default("[]") @db.Text
  missingCommonSkills   String   @default("[]") @db.Text
  suggestedRoles        String   @default("[]") @db.Text
  confidenceScore       Decimal  @default(0.0) @db.Decimal(5, 2)
  reviewedByUser        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Project {
  id                    String            @id @default(uuid())
  clientId              String
  client                ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                 String
  description           String            @db.Text
  category              String
  experienceLevel       ExperienceLevel   @default(INTERMEDIATE)
  minBudget             Decimal           @db.Decimal(12, 2)
  maxBudget             Decimal           @db.Decimal(12, 2)
  currency              String            @default("USD")
  estimatedDurationDays Int               @default(30)
  complexity            ProjectComplexity @default(MEDIUM)
  expectedDeliverables  String?           @db.Text
  deadline              DateTime?
  status                ProjectStatus     @default(OPEN)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  skills       ProjectSkill[]
  attachments  ProjectAttachment[]
  applications Application[]
  contracts    Contract[]
  tasks        Task[]
  projectFiles ProjectFile[]
  reviews      Review[]

  @@index([clientId])
  @@index([status])
  @@index([category])
  @@index([experienceLevel])
}

model ProjectSkill {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
}

model ProjectAttachment {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Application {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  coverLetter         String            @db.Text
  proposedBudget      Decimal           @db.Decimal(12, 2)
  estimatedDays       Int
  status              ApplicationStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  contract Contract?

  @@unique([projectId, freelancerProfileId])
  @@index([projectId])
  @@index([freelancerProfileId])
  @@index([status])
}

model Contract {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  applicationId       String            @unique
  application         Application       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  clientId            String
  client              ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  freelancerProfileId String
  freelancer          FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Restrict)
  agreedBudget        Decimal           @db.Decimal(12, 2)
  currency            String            @default("USD")
  status              ContractStatus    @default(ACTIVE)
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tasks Task[]

  @@index([projectId])
  @@index([clientId])
  @@index([freelancerProfileId])
  @@index([status])
}

model Task {
  id                  String            @id @default(uuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId          String?
  contract            Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  title               String
  description         String?           @db.Text
  assignedToProfileId String?
  assignedToProfile   FreelancerProfile? @relation("AssignedTasks", fields: [assignedToProfileId], references: [id], onDelete: SetNull)
  createdByUserId     String
  createdByUser       User              @relation("CreatedTasks", fields: [createdByUserId], references: [id])
  priority            TaskPriority      @default(MEDIUM)
  status              TaskStatus        @default(TODO)
  dueDate             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  files ProjectFile[]

  @@index([projectId])
  @@index([contractId])
  @@index([assignedToProfileId])
  @@index([status])
}

model ProjectFile {
  id           String       @id @default(uuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User         @relation(fields: [uploaderId], references: [id])
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  category     FileCategory @default(GENERAL)
  createdAt    DateTime     @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([uploaderId])
}

model Review {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Int
  feedback    String   @db.Text
  createdAt   DateTime @default(now())

  @@unique([projectId, reviewerId, revieweeId])
  @@index([projectId])
  @@index([reviewerId])
  @@index([revieweeId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model BackgroundJob {
  id          String    @id @default(uuid())
  jobType     String
  status      JobStatus @default(PENDING)
  payload     String    @default("{}") @db.Text
  result      String?   @db.Text
  error       String?   @db.Text
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
}
